LAMMPS (7 Feb 2024 - Update 1)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
units           si
atom_style      sphere
boundary        f f f
newton          off
comm_modify     vel yes

# Domain definition
region          box block 0 0.1 0 0.1 0 0.2 units box
create_box      1 box
Created orthogonal box = (0 0 0) to (0.1 0.1 0.2)
  1 by 1 by 1 MPI processor grid

# Particle properties
variable        density equal 2500.0    # kg/m^3 (sand-like)

# Define creation region in upper half of box
region          creation block 0.015 0.085 0.015 0.085 0.13 0.19 units box

# Create particles on a lattice
lattice         sc 0.015
Lattice spacing in x,y,z = 0.015 0.015 0.015
create_atoms    1 region creation
Created 100 atoms
  using lattice units in orthogonal box = (0 0 0) to (0.1 0.1 0.2)
  create_atoms CPU = 0.000 seconds

# Set particle properties
set             group all diameter 0.006
Setting atom values ...
  100 settings made for diameter
set             group all density ${density}
set             group all density 2500
Setting atom values ...
  100 settings made for density
set             group all type 1
Setting atom values ...
  100 settings made for type

# Give particles random initial velocities
velocity        all create 0.5 87287 dist gaussian

# Define groups
group           particles type 1
100 atoms in group particles

# Neighbor list
neighbor        0.001 bin
neigh_modify    delay 0

# Particle-particle interaction (Hertzian contact)
pair_style      gran/hertz/history 2e8 NULL 5e7 NULL 0.5 0  # Kn, Kt, gamma_n, gamma_t, xmu, dampflag
pair_coeff      * *

# Timestep
timestep        0.00001   # 10 microseconds

# Gravity
fix             grav all gravity 9.81 vector 0 0 -1

# Walls (granular walls)
fix             xwall1 all wall/gran hertz/history 2e8 NULL 5e7 NULL 0.5 0 xplane 0.0 0.1
fix             ywall1 all wall/gran hertz/history 2e8 NULL 5e7 NULL 0.5 0 yplane 0.0 0.1
fix             zwall1 all wall/gran hertz/history 2e8 NULL 5e7 NULL 0.5 0 zplane 0.0 0.2

# Time integration
fix             integrate all nve/sphere

# Output settings
thermo_style    custom step atoms ke pe etotal
thermo          1000

# Dump for visualization (every 500 steps)
dump            viz all custom 500 dump.grain id type x y z radius vx vy vz
dump_modify     viz sort id

# Run simulation
run             50000
